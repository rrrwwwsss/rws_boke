---
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import type { Post } from '../utils/posts';
import { formatDate, sitePath } from '../utils/posts';

interface Props { post: Post; headings: { depth: number; slug: string; text: string }[]; }
const { post, headings } = Astro.props;
---
<BaseLayout title={post.data.title} description={post.data.description}>
  <article data-pagefind-body>
    <header class="container pt-16 md:pt-24 pb-10">
      <div class="eyebrow mb-8">{post.data.category} / {post.data.series ?? '独立文章'}</div>
      <h1 class="text-[clamp(2.8rem,7vw,6.4rem)] leading-[.95] tracking-[-.065em] font-extrabold max-w-5xl" data-pagefind-meta="title">{post.data.title}</h1>
      <p class="mt-8 text-xl md:text-2xl text-[var(--muted)] max-w-3xl">{post.data.description}</p>
      <div class="mt-9 flex flex-wrap items-center gap-3 text-sm font-mono text-[var(--muted)]">
        <time>{formatDate(post.data.publishedAt)}</time><span>·</span><span>{post.data.readingTime ?? '6 MIN READ'}</span>
        {post.data.tags.map((tag) => <a class="pill" href={sitePath(`/tags/${tag}/`)}>#{tag}</a>)}
      </div>
      {post.data.repository && (
        <a
          class="source-link mt-8 inline-flex items-center gap-3 border border-[var(--ink)] bg-[var(--ink)] px-5 py-3 transition-transform hover:-translate-y-1"
          href={post.data.repository.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${post.data.repository.label ?? '查看项目源码'}（在新窗口打开）`}
        >
          <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5 fill-current"><path d="M12 .7a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2.23c-3.22.7-3.9-1.37-3.9-1.37-.52-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.71.08-.71 1.17.08 1.78 1.2 1.78 1.2 1.04 1.78 2.72 1.27 3.38.97.1-.75.4-1.27.74-1.56-2.57-.29-5.27-1.28-5.27-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.47.11-3.05 0 0 .97-.31 3.16 1.18A10.98 10.98 0 0 1 12 6.12c.98 0 1.95.13 2.87.39 2.2-1.49 3.16-1.18 3.16-1.18.63 1.58.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.71 5.38-5.29 5.67.42.36.79 1.07.79 2.16v3.25c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z" /></svg>
          <span class="font-mono text-sm font-bold tracking-wide">{post.data.repository.label ?? '查看项目源码'}</span>
          <span aria-hidden="true">↗</span>
        </a>
      )}
    </header>
    {post.data.cover && <div class="container"><Image src={post.data.cover} alt={`${post.data.title}封面`} widths={[720, 1180, 1600]} sizes="(max-width: 1180px) 100vw, 1180px" class="w-full max-h-[620px] object-cover border border-[var(--line)]" /></div>}
    <div class="container mt-14 grid lg:grid-cols-[minmax(0,760px)_240px] gap-16 justify-center items-start">
      <div class="prose"><slot /></div>
      <aside class="hidden lg:block sticky top-24 border-l border-[var(--line)] pl-5">
        <p class="eyebrow mb-4">ON THIS PAGE</p>
        <nav class="space-y-2 text-sm text-[var(--muted)]">{headings.filter((h) => h.depth <= 3).map((h) => <a class:list={['block hover:text-[var(--ink)]', h.depth === 3 && 'pl-3']} href={`#${h.slug}`}>{h.text}</a>)}</nav>
      </aside>
    </div>
  </article>
</BaseLayout>
