---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { postHref, sitePath, visiblePosts } from '../utils/posts';

const isDev = import.meta.env.DEV;
const posts = visiblePosts(await getCollection('posts'));
const searchEntries = posts.map((post) => ({
  title: post.data.title,
  description: post.data.description,
  category: post.data.category,
  tags: post.data.tags,
  href: postHref(post),
  text: `${post.data.title} ${post.data.description} ${post.data.category} ${post.data.series ?? ''} ${post.data.tags.join(' ')} ${post.body ?? ''}`.toLowerCase()
}));
---
<BaseLayout title="搜索" description="搜索博客中的文章与技术笔记。">
  <section class="container py-20 min-h-[62vh]">
    <p class="eyebrow">FULL TEXT SEARCH</p>
    <h1 class="section-title mt-4 mb-10">搜索文章</h1>
    {isDev ? (
      <div id="local-search">
        <label class="sr-only" for="local-search-input">搜索文章</label>
        <input id="local-search-input" class="w-full border border-[var(--line)] bg-[var(--paper)] px-5 py-4 text-xl outline-none focus:border-[var(--ink)]" type="search" placeholder="搜索 LangGraph、vLLM、部署……" autocomplete="off" />
        <p id="local-search-status" class="mt-5 text-sm text-[var(--muted)]">输入关键词搜索文章标题、摘要、标签和正文</p>
        <div id="local-search-results" class="mt-5 grid gap-3"></div>
      </div>
    ) : <div id="search"></div>}
    <noscript>请启用 JavaScript 使用全文搜索。</noscript>
  </section>
  {!isDev && <link href={sitePath('/pagefind/pagefind-ui.css')} rel="stylesheet" />}
  {!isDev && <script is:inline src={sitePath('/pagefind/pagefind-ui.js')}></script>}
  {!isDev && <script is:inline>
      window.addEventListener('DOMContentLoaded', () => {
        if (window.PagefindUI) new window.PagefindUI({ element: '#search', showSubResults: true, resetStyles: false, translations: { placeholder: '搜索 LangGraph、vLLM、部署……', zero_results: '没有找到相关内容' } });
      });
    </script>}
  {isDev && <script is:inline define:vars={{ searchEntries }}>
      const input = document.querySelector('#local-search-input');
      const status = document.querySelector('#local-search-status');
      const results = document.querySelector('#local-search-results');

      const renderResults = (query) => {
        const keyword = query.trim().toLowerCase();
        results.replaceChildren();
        if (!keyword) {
          status.textContent = '输入关键词搜索文章标题、摘要、标签和正文';
          return;
        }
        const matches = searchEntries.filter((entry) => entry.text.includes(keyword));
        status.textContent = matches.length ? `找到 ${matches.length} 篇相关文章` : '没有找到相关内容';
        matches.forEach((entry) => {
          const link = document.createElement('a');
          link.href = entry.href;
          link.className = 'card block p-5';
          const meta = document.createElement('p');
          meta.className = 'eyebrow';
          meta.textContent = `${entry.category} · ${entry.tags.join(' / ')}`;
          const title = document.createElement('h2');
          title.className = 'mt-2 text-2xl font-bold tracking-tight';
          title.textContent = entry.title;
          const description = document.createElement('p');
          description.className = 'mt-2 text-[var(--muted)]';
          description.textContent = entry.description;
          link.append(meta, title, description);
          results.append(link);
        });
      };
      input.addEventListener('input', (event) => renderResults(event.target.value));
    </script>}
  <style is:global>
    .pagefind-ui { --pagefind-ui-primary: var(--ink); --pagefind-ui-text: var(--ink); --pagefind-ui-background: var(--paper); --pagefind-ui-border: var(--line); --pagefind-ui-border-width: 1px; --pagefind-ui-border-radius: 0; font-family: inherit; }
    .pagefind-ui__search-input { font-size: 1.2rem !important; }
  </style>
</BaseLayout>
